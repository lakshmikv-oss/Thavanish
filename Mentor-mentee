<div class="modal" id="loginModal"><div class="modal-box"><div class="brand" style="color:#222;margin:0 0 20px"><img class="brand-logo" src="thavanish-logo.png" alt="Thavanish logo"> Thavanish</div><h2>Admin sign in</h2><p>Access volunteer records, schedules, and portal management tools.</p><form id="loginForm"><div class="field"><label>ADMIN EMAIL</label><input type="email" required placeholder="admin@thavanish.org"></div><div class="field"><label>PASSWORD</label><input type="password" required placeholder="Enter password"></div><p id="loginError" style="color:#b54738;display:none;margin:0">Please enter your email and password.</p><div class="form-actions"><button class="cancel" type="button" onclick="document.getElementById('loginModal').classList.remove('show')">Cancel</button><button class="primary" type="submit">Sign in securely</button></div></form></div></div>
<script>
const events=[{day:'17',mon:'AUG',name:'Community Book Drive',info:'9:00 AM · Christ College',status:'Registration open'},{day:'23',mon:'AUG',name:'Campus Clean-up',info:'8:30 AM · Main Quadrangle',status:'Registration open'},{day:'30',mon:'AUG',name:'Peer Tutoring Circle',info:'2:00 PM · Library',status:'Limited spots'}];
const announcements=['Saviskara registrations close this Friday.','New orientation schedule has been published.','Certificates for the Green Campus Drive are ready.'];
function eventMarkup(e,button=true){return `<div class="event-row"><div class="date-box"><b>${e.day}</b><small>${e.mon}</small></div><div class="event-info"><b>${e.name}</b><span>${e.info} · ${e.status}</span></div>${button?'<button class="outline" onclick="showToast(\'Registration confirmed!\')">Register</button>':''}</div>`}
function render(){document.getElementById('eventList').innerHTML=events.slice(0,2).map(e=>eventMarkup(e)).join('');document.getElementById('allEvents').innerHTML=events.map(e=>eventMarkup(e)).join('');document.getElementById('announcementList').innerHTML=announcements.map((a,i)=>`<div class="announcement"><b>${a}</b><span>${i===0?'Today':i===1?'Yesterday':'3 days ago'}</span></div>`).join('');document.getElementById('eventCount').textContent=events.length+1}
render();
function go(id){document.querySelector(`[data-page="${id}"]`)?.click()}
document.getElementById('nav').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));const p=document.getElementById(b.dataset.page);if(p)p.classList.add('active');const labels={dashboard:'Good afternoon, Lakshmi',events:'Find your next opportunity',hours:'Make your impact count',progress:'Celebrate your progress',certificates:'Your earned recognition',profile:'Your volunteer profile',manage:'Admin overview',schedules:'Manage schedules'};document.getElementById('heading').textContent=labels[b.dataset.page]||''});
document.getElementById('volBtn').onclick=()=>setMode(false);document.getElementById('adminBtn').onclick=()=>document.getElementById('loginModal').classList.add('show');
document.getElementById('loginForm').onsubmit=e=>{e.preventDefault();const inputs=e.target.querySelectorAll('input');if(!inputs[0].value||!inputs[1].value){document.getElementById('loginError').style.display='block';return}document.getElementById('loginModal').classList.remove('show');setMode(true);showToast('Signed in to the admin portal')};
function setMode(admin){document.getElementById('app').classList.toggle('admin',admin);document.getElementById('volBtn').classList.toggle('active',!admin);document.getElementById('adminBtn').classList.toggle('active',admin);document.getElementById('navLabel').textContent=admin?'Administration':'Volunteer space';document.getElementById('sideName').textContent=admin?'Priya Mathew':'Lakshmi Krishnan';document.getElementById('sideRole').textContent=admin?'Portal administrator':'Volunteer';document.getElementById('sideInitials').textContent=admin?'PM':'LK';document.getElementById('topInitials').textContent=admin?'PM':'LK';if(admin){go('manage')}else{go('dashboard')}}
document.getElementById('hoursForm').onsubmit=e=>{e.preventDefault();const amount=+document.getElementById('hoursInput').value;const total=78+amount;['totalHours','progressHours'].forEach(i=>document.getElementById(i).textContent=total);const pct=Math.min(total,100);['progressBar','progressBar2'].forEach(i=>document.getElementById(i).style.width=pct+'%');document.getElementById('progressText').textContent=total+' / 100 hrs';showToast(`${amount} hours submitted for approval`);e.target.reset()};
let current='meeting';function openModal(type){current=type;const configs={meeting:{title:'Schedule a meeting',text:'The assigned volunteer will see this as their next mentor meeting.',fields:`<div class="field"><label>MEETING TITLE</label><input id="mTitle" required value="Growth check-in with Sarah"></div><div class="field"><label>DATE & TIME</label><input id="mDate" required value="12 Aug 2026, 3:00 PM"></div><div class="field"><label>VENUE</label><input id="mVenue" required value="Seminar Hall"></div><div class="field"><label>AGENDA</label><textarea id="mAgenda">Review July volunteering, discuss upcoming events, and set your August goals.</textarea></div>`},event:{title:'Add a volunteer event',text:'This opportunity will appear immediately on the volunteer dashboard.',fields:`<div class="field"><label>EVENT NAME</label><input id="eName" required placeholder="e.g. Food distribution drive"></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><label>DAY</label><input id="eDay" required type="number" min="1" max="31" value="20"></div><div class="field"><label>MONTH</label><select id="eMon"><option>AUG</option><option>SEP</option></select></div></div><div class="field"><label>TIME & LOCATION</label><input id="eInfo" required placeholder="10:00 AM · Campus"></div>`},announcement:{title:'Post an announcement',text:'Your update will instantly show in the volunteer announcement feed.',fields:`<div class="field"><label>ANNOUNCEMENT</label><textarea id="aText" required placeholder="Write an important update..."></textarea></div>`}};let c=configs[type];document.getElementById('modalTitle').textContent=c.title;document.getElementById('modalText').textContent=c.text;document.getElementById('modalFields').innerHTML=c.fields;document.getElementById('modal').classList.add('show')}
function closeModal(){document.getElementById('modal').classList.remove('show')};document.getElementById('modal').onclick=e=>{if(e.target.id==='modal')closeModal()};
document.getElementById('modalForm').onsubmit=e=>{e.preventDefault();if(current==='meeting'){document.getElementById('meetingTitle').textContent=document.getElementById('mTitle').value;document.getElementById('meetingDate').textContent=document.getElementById('mDate').value;document.getElementById('meetingVenue').textContent=document.getElementById('mVenue').value;document.getElementById('meetingAgenda').textContent=document.getElementById('mAgenda').value;document.getElementById('meetingCount').textContent=24;showToast('Meeting scheduled and volunteer notified')}if(current==='event'){events.unshift({day:document.getElementById('eDay').value.padStart(2,'0'),mon:document.getElementById('eMon').value,name:document.getElementById('eName').value,info:document.getElementById('eInfo').value,status:'Registration open'});render();showToast('New event is live for volunteers')}if(current==='announcement'){announcements.unshift(document.getElementById('aText').value);render();showToast('Announcement published')}closeModal()};
let tt;function showToast(msg){let t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('show'),2800)}
</script>
</body></html>
